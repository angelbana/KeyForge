{
  "name": "keyforge",
  "version": "0.1.2",
  "private": true,
  "description": "Local SSH key and configuration manager",
  "main": "compiled/main/main.js",
  "scripts": {
    "dev": "npm run build && electron ../verification/build-work/compiled/main/main.js",
    "build": "tsc -p tsconfig.main.json && tsc --noEmit -p tsconfig.json && vite build && node scripts/link-dependencies.cjs",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src tests scripts",
    "check": "npm run lint && npm run test && npm run build",
    "pack": "npm run build && electron-builder --dir && node scripts/publish-local-build.cjs",
    "dist": "npm run build && electron-builder",
    "smoke": "npm run build && electron scripts/desktop-smoke.cjs"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "io.keyforge.desktop",
    "productName": "KeyForge",
    "directories": {
      "output": "../verification/build-work/packages"
    },
    "files": [
      {
        "from": "../verification/build-work/compiled",
        "to": "compiled",
        "filter": [
          "**/*",
          "!node_modules/**/*"
        ]
      },
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "npmRebuild": false
  },
  "author": {
    "name": "angelbana",
    "email": "ilnazniyaz2015@gmail.com"
  }
}
